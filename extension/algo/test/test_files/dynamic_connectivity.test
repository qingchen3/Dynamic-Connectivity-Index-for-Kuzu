# Rollback must preserve the base edge and all four index answers.
# Committing the same deletion must then change the connectivity answers.
-CASE DCNeighbourProviderRollbackPreservesConnectivity
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE Person(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person, eid INT64);
---- ok
# UNWIND feeds every row through one CREATE operator, so offsets are assigned
# in feed order. Do NOT replace this with a single multi-pattern CREATE
# ((u0:Person{id:0}), (u1:Person{id:1}), ...): the planner reorders the
# patterns within the clause and the offsets come out permuted. Every
# connectivity argument below is a literal offset and depends on this.
-STATEMENT UNWIND range(0, 10) AS i CREATE (:Person {id: i});
---- ok
-STATEMENT MATCH (p:Person) RETURN p.id, OFFSET(ID(p));
