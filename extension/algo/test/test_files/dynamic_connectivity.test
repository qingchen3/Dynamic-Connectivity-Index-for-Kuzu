True
# Now commit the same deletion: the answers must flip.
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT MATCH ()-[r:Knows]->() WHERE r.eid = 4 DELETE r;
---- ok
-STATEMENT COMMIT;
---- ok
-STATEMENT CALL DYNAMIC_CONNECTIVITY_QUERY('Person', 4, 5, 'dc_stree') RETURN *;
