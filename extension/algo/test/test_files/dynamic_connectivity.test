Dynamic connectivity index dc_dtree_csr has been created with 12 edges.
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT MATCH ()-[r:Knows]->() WHERE r.eid = 4 DELETE r;
---- ok
-STATEMENT ROLLBACK;
---- ok
# The base table must still hold the bridge.
-STATEMENT MATCH ()-[r:Knows]->() WHERE r.eid = 4 RETURN count(r);
---- 1
1
# And so must every index.
-STATEMENT CALL DYNAMIC_CONNECTIVITY_QUERY('Person', 4, 5, 'dc_stree') RETURN *;
