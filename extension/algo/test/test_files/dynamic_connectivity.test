# Check deletion before and after an explicit checkpoint on a disk-backed
# database. Checkpoint must preserve the logical graph. These assertions do
# not by themselves establish physical scan coverage or restart recovery.
-CASE DCNeighbourProviderDeleteAcrossCheckpoint
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE Person(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person, eid INT64);
